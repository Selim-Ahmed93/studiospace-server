PORT=5000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB=studiospace

# Primary frontend origin (the URL users open in the browser)
CLIENT_URL=http://localhost:3000

# Optional comma-separated extra origins, e.g. a Vercel preview deployment
ADDITIONAL_CLIENT_URLS=

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Public frontend origin. The frontend proxies /api/* to this API, so Better
# Auth must build OAuth redirect URIs on the frontend origin. Keeping the
# browser flow same-origin is what keeps the OAuth state cookie first-party.
BETTER_AUTH_URL=http://localhost:3000

# Optional: enables Google login only when both values are set
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
